PORT=5000
FRONTEND_URL=https://mis-frontend-g6g3.onrender.com
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=neondb
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=15000
NEON_API_KEY=replace-with-neon-api-key
NEON_API_URL=https://console.neon.tech/api/v2
NEON_ORG_ID=replace-with-neon-organization-id
NEON_REGION=aws-us-east-2
NEON_PG_VERSION=16
NEON_ROLE_NAME=neondb_owner
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_ADMIN=1d
JWT_EXPIRE_TENANT=1d
NODE_ENV=production
ENABLE_AUTO_MIGRATE=false
