{
  "dev": {
    "driver": "pg",
    "host": { "ENV": "DB_HOST" },
    "port": { "ENV": "DB_PORT" },
    "database": { "ENV": "DB_NAME" },
    "user": { "ENV": "DB_USER" },
    "password": { "ENV": "DB_PASSWORD" },
    "ssl": false
  },
  "production": {
    "driver": "pg",
    "url": { "ENV": "DATABASE_URL" },
    "ssl": { "rejectUnauthorized": false }
  }
}